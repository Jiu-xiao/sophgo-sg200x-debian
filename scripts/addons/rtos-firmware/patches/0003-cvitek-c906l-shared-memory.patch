From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Sat, 1 Aug 2026 02:30:00 +0800
Subject: [PATCH] freertos: reserve the C906L shared-memory queues

Keep the 132 KiB fixed-slot transport outside all loadable firmware segments.
The final 4 KiB boot-trace page remains independently reserved.
---
 freertos/cvitek/scripts/cv181x_lscript.ld | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/freertos/cvitek/scripts/cv181x_lscript.ld b/freertos/cvitek/scripts/cv181x_lscript.ld
--- a/freertos/cvitek/scripts/cv181x_lscript.ld
+++ b/freertos/cvitek/scripts/cv181x_lscript.ld
@@ -24,6 +24,7 @@ _BOOT_TRACE_SIZE = 0x1000;
 _BOOT_TRACE_SIZE = 0x1000;
+__rtos_shm_start = CVIMMAP_RTOS_SHM_ADDR;
 
 MEMORY
 {
-   psu_ddr_0_MEM_0 : ORIGIN = CVIMMAP_FREERTOS_ADDR , LENGTH = CVIMMAP_FREERTOS_SIZE - _BOOT_TRACE_SIZE
+   psu_ddr_0_MEM_0 : ORIGIN = CVIMMAP_FREERTOS_ADDR , LENGTH = CVIMMAP_RTOS_SHM_ADDR - CVIMMAP_FREERTOS_ADDR
 }
-- 
