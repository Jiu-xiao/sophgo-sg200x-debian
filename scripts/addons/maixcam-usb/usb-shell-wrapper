#!/bin/sh

export HOME=/root
export TERM=vt100
export PS1='root@maixcam:\w\$ '

# Drop any bytes the host sent during ACM re-enumeration/terminal probing.
stty -F /dev/ttyGS0 -echo 2>/dev/null || true
dd if=/dev/ttyGS0 of=/dev/null bs=256 count=1 iflag=nonblock 2>/dev/null || true
sleep 0.2
dd if=/dev/ttyGS0 of=/dev/null bs=256 count=1 iflag=nonblock 2>/dev/null || true
stty -F /dev/ttyGS0 echo 2>/dev/null || true

exec /bin/bash --noprofile --norc -i
