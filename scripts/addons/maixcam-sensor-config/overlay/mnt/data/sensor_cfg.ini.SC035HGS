[source]

;type = SOURCE_USER_FE

dev_num = 1

; section for sensor

[sensor]

; sensor name
name = SMS_SC035HGS_MIPI_480P_120FPS_12BIT

bus_id = 4

; The parser uses decimal integers. 48 is I2C address 0x30.
sns_i2c_addr = 48

mipi_dev = 0

; clock RX2, data lane 0 RX4, data lane 1 RX3
lane_id = 2, 4, 3, -1, -1

pn_swap = 0, 0, 0, 0, 0

mclk_en = 1

mclk = 1
