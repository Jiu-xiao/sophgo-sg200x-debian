+static long cvi_rtos_cmdqu_ioctl(struct file *filp, unsigned int cmd,
+	unsigned long arg)
+{
+	struct cvi_rtos_cmdqu_device *device = filp->private_data;
+	long ret;
+
+	if (!device)
+		return -ENODEV;
+	ret = down_read_killable(&device->file_ops_lock);
+	if (ret)
+		return ret;
+	if (READ_ONCE(device->shutting_down)) {
+		ret = -ENODEV;
+	} else {
+		ret = cvi_rtos_cmdqu_ioctl_locked(filp, cmd, arg);
+		if (READ_ONCE(device->shutting_down))
+			ret = -ENODEV;
+	}
+	up_read(&device->file_ops_lock);
+	return ret;
+}
+
+static __poll_t cvi_rtos_cmdqu_poll(struct file *file,
+	struct poll_table_struct *wait)
+{
+	struct cvi_rtos_cmdqu_device *device = file->private_data;
+	__poll_t mask;
+
+	if (!device)
+		return EPOLLERR | EPOLLHUP;
+	down_read(&device->file_ops_lock);
+	if (READ_ONCE(device->shutting_down)) {
+		mask = EPOLLERR | EPOLLHUP;
+	} else {
+		mask = sg2002_rtos_shm_linux_poll(device->shm, file, wait);
+		if (READ_ONCE(device->shutting_down))
+			mask = EPOLLERR | EPOLLHUP;
+	}
+	up_read(&device->file_ops_lock);
+	return mask;
+}
