 struct cvi_rtos_cmdqu_device {
 	struct device *dev;
 	struct miscdevice miscdev;
+	struct sg2002_rtos_shm_linux *shm;
+	struct kref refcount;
+	struct mutex lifecycle_lock;
+	struct rw_semaphore file_ops_lock;
+	bool shutting_down;
 };
 
 spinlock_t mailbox_queue_lock;
@@ -40,14 +49,54 @@ static __u64  reg_base;
 static __u32  reg_base;
 #endif
 static int mailbox_irq;
+static unsigned long legacy_shm_start;
+static unsigned long legacy_shm_size;
+
+module_param_named(shm_start, legacy_shm_start, ulong, 0444);
+MODULE_PARM_DESC(shm_start,
+	"Physical start of the shared-memory transport for legacy device trees");
+module_param_named(shm_size, legacy_shm_size, ulong, 0444);
+MODULE_PARM_DESC(shm_size,
+	"Size of the shared-memory transport for legacy device trees");
+
+static void cvi_rtos_cmdqu_device_release(struct kref *refcount)
+{
+	struct cvi_rtos_cmdqu_device *device = container_of(
+		refcount, struct cvi_rtos_cmdqu_device, refcount);
+
+	sg2002_rtos_shm_linux_destroy(device->shm);
+	kfree(device);
+}
 
 static int cvi_rtos_cmdqu_open(struct inode *inode, struct file *file)
 {
+	struct miscdevice *miscdev = file->private_data;
+	struct cvi_rtos_cmdqu_device *device;
+
+	device = container_of(miscdev, struct cvi_rtos_cmdqu_device, miscdev);
+	mutex_lock(&device->lifecycle_lock);
+	if (device->shutting_down) {
+		mutex_unlock(&device->lifecycle_lock);
+		return -ENODEV;
+	}
+	kref_get(&device->refcount);
+	file->private_data = device;
+	mutex_unlock(&device->lifecycle_lock);
 	return 0;
 }
 
 static int cvi_rtos_cmdqu_release(struct inode *inode, struct file *file)
 {
+	struct cvi_rtos_cmdqu_device *device = file->private_data;
+
+	if (!device)
+		return 0;
+	down_read(&device->file_ops_lock);
+	if (!READ_ONCE(device->shutting_down))
+		sg2002_rtos_shm_linux_release(device->shm, file);
+	up_read(&device->file_ops_lock);
+	file->private_data = NULL;
+	kref_put(&device->refcount, cvi_rtos_cmdqu_device_release);
 	return 0;
 }
 
