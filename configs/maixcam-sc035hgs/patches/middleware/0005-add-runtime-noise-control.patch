+static int read_noise_snapshot(int isp_channel, struct noise_snapshot *snapshot)
+{
+	if (!snapshot)
+		return -EINVAL;
+
+	memset(snapshot, 0, sizeof(*snapshot));
+	if (CVI_ISP_GetNRAttr(isp_channel, &snapshot->bnr) != CVI_SUCCESS ||
+	    CVI_ISP_GetNRFilterAttr(isp_channel, &snapshot->bnr_filter) !=
+		CVI_SUCCESS ||
+	    CVI_ISP_GetYNRAttr(isp_channel, &snapshot->ynr) != CVI_SUCCESS ||
+	    CVI_ISP_GetYNRFilterAttr(isp_channel, &snapshot->ynr_filter) !=
+		CVI_SUCCESS ||
+	    CVI_ISP_GetTNRAttr(isp_channel, &snapshot->tnr) != CVI_SUCCESS ||
+	    CVI_ISP_GetSharpenAttr(isp_channel, &snapshot->sharpen) !=
+		CVI_SUCCESS)
+		return -EIO;
+	return 0;
+}
+
+static int save_noise_snapshot(int isp_channel)
+{
+	struct noise_snapshot snapshot;
+	int ret;
+
+	ret = read_noise_snapshot(isp_channel, &snapshot);
+	if (ret)
+		return ret;
+	snapshot.valid = 1;
+	saved_noise = snapshot;
+	return 0;
+}
+
+static int restore_noise_snapshot(int isp_channel)
+{
+	struct noise_snapshot current;
+	int failed = 0;
+
+	if (!saved_noise.valid)
+		return -ENOENT;
+
+	if (CVI_ISP_SetNRFilterAttr(isp_channel, &saved_noise.bnr_filter) !=
+	    CVI_SUCCESS)
+		failed = 1;
+	if (CVI_ISP_SetNRAttr(isp_channel, &saved_noise.bnr) != CVI_SUCCESS)
+		failed = 1;
+	if (CVI_ISP_SetYNRFilterAttr(isp_channel, &saved_noise.ynr_filter) !=
+	    CVI_SUCCESS)
+		failed = 1;
+	if (CVI_ISP_SetYNRAttr(isp_channel, &saved_noise.ynr) != CVI_SUCCESS)
+		failed = 1;
+	if (CVI_ISP_SetTNRAttr(isp_channel, &saved_noise.tnr) != CVI_SUCCESS)
+		failed = 1;
+	if (CVI_ISP_SetSharpenAttr(isp_channel, &saved_noise.sharpen) !=
+	    CVI_SUCCESS)
+		failed = 1;
+	if (failed)
+		return -EIO;
+
+	if (read_noise_snapshot(isp_channel, &current))
+		return -EIO;
+	if (memcmp(&current.bnr, &saved_noise.bnr, sizeof(current.bnr)) ||
+	    memcmp(&current.bnr_filter, &saved_noise.bnr_filter,
+		   sizeof(current.bnr_filter)) ||
+	    memcmp(&current.ynr, &saved_noise.ynr, sizeof(current.ynr)) ||
+	    memcmp(&current.ynr_filter, &saved_noise.ynr_filter,
+		   sizeof(current.ynr_filter)) ||
+	    memcmp(&current.tnr, &saved_noise.tnr, sizeof(current.tnr)) ||
+	    memcmp(&current.sharpen, &saved_noise.sharpen,
+		   sizeof(current.sharpen)))
+		return -EIO;
+	return 0;
+}
+
+static int append_response(char *response, size_t response_size, size_t *used,
+			   const char *format, ...)
+{
+	va_list arguments;
+	int length;
+
+	if (!response || !used || *used >= response_size)
+		return -ENOSPC;
+	va_start(arguments, format);
+	length = vsnprintf(response + *used, response_size - *used, format,
+			   arguments);
+	va_end(arguments);
+	if (length < 0)
+		return -EIO;
+	if ((size_t)length >= response_size - *used)
+		return -ENOSPC;
+	*used += (size_t)length;
+	return 0;
+}
+
+static int append_u8_curve(char *response, size_t response_size, size_t *used,
+			   const CVI_U8 *values)
+{
+	int ret;
+
+	for (size_t i = 0; i < ISP_AUTO_ISO_STRENGTH_NUM; ++i) {
+		ret = append_response(response, response_size, used, "%s%u",
+				      i ? "," : "", values[i]);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+static void format_noise_status(int isp_channel, char *response,
+				size_t response_size)
+{
+	struct noise_snapshot current;
+	size_t used = 0;
+	int ret;
+
+	ret = read_noise_snapshot(isp_channel, &current);
+	if (ret) {
+		snprintf(response, response_size,
+			 "ERR noise_query_failed code=%d", ret);
+		return;
+	}
+
+	ret = append_response(response, response_size, &used,
+			      "OK snapshot=%d bnr enable=%d op=%d manual=%u auto=",
+			      saved_noise.valid, current.bnr.Enable,
+			      current.bnr.enOpType,
+			      current.bnr.stManual.NoiseSuppressStr);
+	if (!ret)
+		ret = append_u8_curve(response, response_size, &used,
+				      current.bnr.stAuto.NoiseSuppressStr);
+	if (!ret)
+		ret = append_response(response, response_size, &used,
+			      " ynr enable=%d op=%d manual=%u auto=",
+			      current.ynr.Enable, current.ynr.enOpType,
+			      current.ynr.stManual.NoiseSuppressStr);
+	if (!ret)
+		ret = append_u8_curve(response, response_size, &used,
+				      current.ynr.stAuto.NoiseSuppressStr);
+	if (!ret)
+		ret = append_response(response, response_size, &used,
+			      " tnr enable=%d op=%d manual=%u auto=",
+			      current.tnr.Enable, current.tnr.enOpType,
+			      current.tnr.stManual.TnrStrength0);
+	if (!ret)
+		ret = append_u8_curve(response, response_size, &used,
+				      current.tnr.stAuto.TnrStrength0);
+	if (!ret)
+		ret = append_response(response, response_size, &used,
+			      " sharpen enable=%d op=%d manual=%u/%u/%u "
+			      "auto_global=", current.sharpen.Enable,
+			      current.sharpen.enOpType,
+			      current.sharpen.stManual.GlobalGain,
+			      current.sharpen.stManual.OverShootGain,
+			      current.sharpen.stManual.UnderShootGain);
+	if (!ret)
+		ret = append_u8_curve(response, response_size, &used,
+				      current.sharpen.stAuto.GlobalGain);
+	if (!ret)
+		ret = append_response(response, response_size, &used,
+			      " auto_over=");
+	if (!ret)
+		ret = append_u8_curve(response, response_size, &used,
+				      current.sharpen.stAuto.OverShootGain);
+	if (!ret)
+		ret = append_response(response, response_size, &used,
+			      " auto_under=");
+	if (!ret)
+		ret = append_u8_curve(response, response_size, &used,
+				      current.sharpen.stAuto.UnderShootGain);
+	if (ret)
+		snprintf(response, response_size, "ERR noise_response_too_large");
+}
