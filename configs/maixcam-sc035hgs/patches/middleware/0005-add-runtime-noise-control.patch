+static int set_noise_value(int isp_channel, const char *module,
+			   uint32_t iso_index, uint32_t value)
+{
+	if (!saved_noise.valid)
+		return -ENOENT;
+	if (iso_index >= ISP_AUTO_ISO_STRENGTH_NUM || value > UINT8_MAX)
+		return -ERANGE;
+
+	if (!strcmp(module, "bnr")) {
+		ISP_NR_ATTR_S attr;
+
+		memset(&attr, 0, sizeof(attr));
+		if (CVI_ISP_GetNRAttr(isp_channel, &attr) != CVI_SUCCESS)
+			return -EIO;
+		if (attr.enOpType != OP_TYPE_AUTO)
+			return -EPERM;
+		attr.stAuto.NoiseSuppressStr[iso_index] = (CVI_U8)value;
+		return CVI_ISP_SetNRAttr(isp_channel, &attr) == CVI_SUCCESS ?
+			0 : -EIO;
+	}
+	if (!strcmp(module, "ynr")) {
+		ISP_YNR_ATTR_S attr;
+
+		memset(&attr, 0, sizeof(attr));
+		if (CVI_ISP_GetYNRAttr(isp_channel, &attr) != CVI_SUCCESS)
+			return -EIO;
+		if (attr.enOpType != OP_TYPE_AUTO)
+			return -EPERM;
+		attr.stAuto.NoiseSuppressStr[iso_index] = (CVI_U8)value;
+		return CVI_ISP_SetYNRAttr(isp_channel, &attr) == CVI_SUCCESS ?
+			0 : -EIO;
+	}
+	if (!strcmp(module, "tnr")) {
+		ISP_TNR_ATTR_S attr;
+
+		memset(&attr, 0, sizeof(attr));
+		if (CVI_ISP_GetTNRAttr(isp_channel, &attr) != CVI_SUCCESS)
+			return -EIO;
+		if (attr.enOpType != OP_TYPE_AUTO)
+			return -EPERM;
+		attr.stAuto.TnrStrength0[iso_index] = (CVI_U8)value;
+		return CVI_ISP_SetTNRAttr(isp_channel, &attr) == CVI_SUCCESS ?
+			0 : -EIO;
+	}
+	if (!strcmp(module, "sharpen")) {
+		ISP_SHARPEN_ATTR_S attr;
+
+		memset(&attr, 0, sizeof(attr));
+		if (CVI_ISP_GetSharpenAttr(isp_channel, &attr) != CVI_SUCCESS)
+			return -EIO;
+		if (attr.enOpType != OP_TYPE_AUTO)
+			return -EPERM;
+		attr.stAuto.GlobalGain[iso_index] = (CVI_U8)value;
+		return CVI_ISP_SetSharpenAttr(isp_channel, &attr) == CVI_SUCCESS ?
+			0 : -EIO;
+	}
+	return -EINVAL;
+}
