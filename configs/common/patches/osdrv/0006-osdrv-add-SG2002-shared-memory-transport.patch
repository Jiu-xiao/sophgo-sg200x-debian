@@ -521,6 +567,7 @@ static int _register_dev(struct cvi_rtos_cmdqu_device *ndev)
 	ndev->miscdev.minor = MISC_DYNAMIC_MINOR;
 	ndev->miscdev.name = RTOS_CMDQU_DEV_NAME;
