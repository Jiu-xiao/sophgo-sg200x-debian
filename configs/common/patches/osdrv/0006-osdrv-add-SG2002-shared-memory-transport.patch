 {
 	unsigned long flags;
@@ -425,6 +457,11 @@ static long cvi_rtos_cmdqu_ioctl(struct file *filp, unsigned int cmd, unsigned l
 
 	pr_debug("%s dev=%p\n", __func__, dev);
 	switch (cmd) {
