+err_shm:
+	sg2002_rtos_shm_linux_destroy(ndev->shm);
+	return ret;
 }
 
 static int cvi_rtos_cmdqu_remove(struct platform_device *pdev)
@@ -637,9 +709,10 @@ static int cvi_rtos_cmdqu_remove(struct platform_device *pdev)
 		pr_err("Failed to rm rtos cmdqu cb\n");
 	}
 	misc_deregister(&ndev->miscdev);
-	platform_set_drvdata(pdev, NULL);
 	/* remove irq handler*/
 	free_irq(mailbox_irq, ndev);
+	sg2002_rtos_shm_linux_destroy(ndev->shm);
+	platform_set_drvdata(pdev, NULL);
 	rtos_cmdqu_deinit();
 	pr_debug("%s DONE\n", __func__);
 
diff --git a/interdrv/rtos_cmdqu/sg2002_rtos_shm_linux.c b/interdrv/rtos_cmdqu/sg2002_rtos_shm_linux.c
new file mode 100644
index 0000000..f467e80
--- /dev/null
+++ b/interdrv/rtos_cmdqu/sg2002_rtos_shm_linux.c
@@ -0,0 +1,591 @@
+#include "sg2002_rtos_shm_linux.h"
+
+#include <linux/device.h>
+#include <linux/err.h>
+#include <linux/io.h>
+#include <linux/jiffies.h>
+#include <linux/mutex.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+#include <linux/wait.h>
+#include <linux/workqueue.h>
+
+#include "sg2002_rtos_shm.h"
+
+#define SG2002_RTOS_SHM_KICK_MAX_ATTEMPTS 100
+
+struct sg2002_rtos_shm_linux {
+	struct device *device;
+	void __iomem *base;
+	resource_size_t size;
+	struct mutex owner_lock;
+	struct mutex tx_lock;
+	struct mutex rx_lock;
+	wait_queue_head_t wait;
+	struct delayed_work kick_work;
+	atomic_t kick_attempts;
+	atomic_t notifications;
+	struct file *owner;
+	sg2002_rtos_shm_kick_fn kick;
+	void *kick_context;
+	u32 generation;
+	u32 next_sequence;
+};
+
+static struct sg2002_rtos_shm_control __iomem *shm_control(
+	struct sg2002_rtos_shm_linux *transport)
+{
+	return (struct sg2002_rtos_shm_control __iomem *)transport->base;
+}
+
+static bool layout_valid(struct sg2002_rtos_shm_linux *transport)
+{
+	struct sg2002_rtos_shm_control __iomem *control;
+
+	if (!transport || !transport->base ||
+	    transport->size != SG2002_RTOS_SHM_REGION_SIZE)
+		return false;
+	control = shm_control(transport);
+	return readl(&control->layout.magic) == SG2002_RTOS_SHM_MAGIC &&
+	       readw(&control->layout.abi_version) ==
+		       SG2002_RTOS_SHM_ABI_VERSION &&
+	       readw(&control->layout.control_size) ==
+		       SG2002_RTOS_SHM_CONTROL_SIZE &&
+	       readl(&control->layout.region_size) ==
+		       SG2002_RTOS_SHM_REGION_SIZE &&
+	       readw(&control->layout.slot_size) ==
+		       SG2002_RTOS_SHM_SLOT_SIZE &&
+	       readw(&control->layout.slot_count) ==
+		       SG2002_RTOS_SHM_SLOT_COUNT &&
+	       readl(&control->layout.request_offset) ==
+		       SG2002_RTOS_SHM_REQUEST_OFFSET &&
+	       readl(&control->layout.response_offset) ==
+		       SG2002_RTOS_SHM_RESPONSE_OFFSET;
+}
+
+static bool rtos_ready(struct sg2002_rtos_shm_linux *transport)
+{
+	struct sg2002_rtos_shm_control __iomem *control;
+	u32 generation;
+
+	if (!layout_valid(transport))
+		return false;
+	control = shm_control(transport);
+	generation = READ_ONCE(transport->generation);
+	return generation != 0U &&
+	       readl(&control->layout.generation) == generation &&
+	       readl(&control->linux_peer.state) ==
+		       SG2002_RTOS_SHM_STATE_READY &&
+	       readl(&control->linux_peer.generation) == generation &&
+	       readl(&control->rtos_peer.state) ==
+		       SG2002_RTOS_SHM_STATE_READY &&
+	       readl(&control->rtos_peer.generation) == generation;
+}
+
+static int ring_occupancy(
+	struct sg2002_rtos_shm_counter_line __iomem *producer,
+	struct sg2002_rtos_shm_counter_line __iomem *consumer,
+	u32 *producer_value, u32 *consumer_value, u32 *occupancy)
+{
+	u32 current_producer = readl(&producer->value);
+	u32 current_consumer = readl(&consumer->value);
+	u32 current_occupancy = current_producer - current_consumer;
+
+	if (current_occupancy > SG2002_RTOS_SHM_SLOT_COUNT)
+		return -EPROTO;
+	if (producer_value)
+		*producer_value = current_producer;
+	if (consumer_value)
+		*consumer_value = current_consumer;
+	if (occupancy)
+		*occupancy = current_occupancy;
+	return 0;
+}
+
+static int request_occupancy(struct sg2002_rtos_shm_linux *transport,
+	u32 *producer, u32 *consumer, u32 *occupancy)
+{
+	struct sg2002_rtos_shm_control __iomem *control =
+		shm_control(transport);
+
+	return ring_occupancy(&control->request_producer,
+			      &control->request_consumer,
+			      producer, consumer, occupancy);
+}
+
+static int response_occupancy(struct sg2002_rtos_shm_linux *transport,
+	u32 *producer, u32 *consumer, u32 *occupancy)
+{
+	struct sg2002_rtos_shm_control __iomem *control =
+		shm_control(transport);
+
+	return ring_occupancy(&control->response_producer,
+			      &control->response_consumer,
+			      producer, consumer, occupancy);
+}
+
+static bool request_wait_done(struct sg2002_rtos_shm_linux *transport)
+{
+	u32 occupancy;
+
+	if (!rtos_ready(transport))
+		return true;
+	if (request_occupancy(transport, NULL, NULL, &occupancy))
+		return true;
+	return occupancy < SG2002_RTOS_SHM_SLOT_COUNT;
+}
+
+static bool response_wait_done(struct sg2002_rtos_shm_linux *transport)
+{
+	u32 occupancy;
+
+	if (!rtos_ready(transport))
+		return true;
+	if (response_occupancy(transport, NULL, NULL, &occupancy))
+		return true;
+	return occupancy > 0U;
+}
+
+static long wait_jiffies(u32 timeout_ms)
+{
+	if (timeout_ms == ~0U)
+		return MAX_SCHEDULE_TIMEOUT;
+	return max_t(long, 1, msecs_to_jiffies(timeout_ms));
+}
+
+static void initialize_generation(
+	struct sg2002_rtos_shm_linux *transport, u32 previous_generation)
+{
+	struct sg2002_rtos_shm_control __iomem *control =
+		shm_control(transport);
+	u32 generation = previous_generation + 1U;
+
+	if (generation == 0U)
+		generation = 1U;
+
+	memset_io(transport->base, 0, transport->size);
+	writew(SG2002_RTOS_SHM_ABI_VERSION,
+	       &control->layout.abi_version);
+	writew(SG2002_RTOS_SHM_CONTROL_SIZE,
+	       &control->layout.control_size);
+	writel(SG2002_RTOS_SHM_REGION_SIZE, &control->layout.region_size);
+	writew(SG2002_RTOS_SHM_SLOT_SIZE, &control->layout.slot_size);
+	writew(SG2002_RTOS_SHM_SLOT_COUNT, &control->layout.slot_count);
+	writel(SG2002_RTOS_SHM_REQUEST_OFFSET,
+	       &control->layout.request_offset);
+	writel(SG2002_RTOS_SHM_RESPONSE_OFFSET,
+	       &control->layout.response_offset);
+	writel(generation, &control->layout.generation);
+	writel(SG2002_RTOS_SHM_FEATURES, &control->layout.features);
+	wmb();
+	writel(SG2002_RTOS_SHM_MAGIC, &control->layout.magic);
+	writel(generation, &control->linux_peer.generation);
+	wmb();
+	writel(SG2002_RTOS_SHM_STATE_READY, &control->linux_peer.state);
+	wmb();
+	WRITE_ONCE(transport->generation, generation);
+	WRITE_ONCE(transport->next_sequence, 1U);
+}
+
+static void fill_info(struct sg2002_rtos_shm_linux *transport,
+	struct sg2002_rtos_shm_info *info)
+{
+	memset(info, 0, sizeof(*info));
+	info->abi_version = SG2002_RTOS_SHM_ABI_VERSION;
+	info->region_size = SG2002_RTOS_SHM_REGION_SIZE;
+	info->control_size = SG2002_RTOS_SHM_CONTROL_SIZE;
+	info->slot_size = SG2002_RTOS_SHM_SLOT_SIZE;
+	info->slot_count = SG2002_RTOS_SHM_SLOT_COUNT;
+	info->payload_size = SG2002_RTOS_SHM_PAYLOAD_SIZE;
+	info->generation = READ_ONCE(transport->generation);
+	info->features = SG2002_RTOS_SHM_FEATURES;
+}
+
+static bool is_owner(struct sg2002_rtos_shm_linux *transport,
+	struct file *owner)
+{
+	return transport && owner && READ_ONCE(transport->owner) == owner;
+}
+
+static int kick_generation(struct sg2002_rtos_shm_linux *transport,
+	u32 generation)
+{
+	return transport->kick(transport->kick_context, generation);
+}
+
+static int kick_now(struct sg2002_rtos_shm_linux *transport)
+{
+	return kick_generation(transport, READ_ONCE(transport->generation));
+}
+
+static void kick_work(struct work_struct *work)
+{
+	struct sg2002_rtos_shm_linux *transport = container_of(
+		to_delayed_work(work), struct sg2002_rtos_shm_linux,
+		kick_work);
+	int attempt;
+
+	if (!READ_ONCE(transport->owner))
+		return;
+	if (!kick_now(transport)) {
+		atomic_set(&transport->kick_attempts, 0);
+		return;
+	}
+
+	attempt = atomic_inc_return(&transport->kick_attempts);
+	if (attempt < SG2002_RTOS_SHM_KICK_MAX_ATTEMPTS &&
+	    READ_ONCE(transport->owner)) {
+		schedule_delayed_work(&transport->kick_work,
+				      msecs_to_jiffies(1));
+	} else {
+		dev_err_ratelimited(transport->device,
+			"shared-memory doorbell remained busy\n");
+	}
+}
+
+static void request_kick(struct sg2002_rtos_shm_linux *transport)
+{
+	atomic_set(&transport->kick_attempts, 0);
+	if (kick_now(transport))
+		schedule_delayed_work(&transport->kick_work,
+				      msecs_to_jiffies(1));
+}
+
+static long acquire(struct sg2002_rtos_shm_linux *transport,
+	struct file *owner, unsigned long argument)
+{
+	struct sg2002_rtos_shm_control __iomem *control =
+		shm_control(transport);
+	struct sg2002_rtos_shm_info info;
+	u32 previous_generation = 0U;
+	int notification = 0;
+	bool quiesce = false;
+	long wait_result;
+	int ret;
+
+	ret = mutex_lock_interruptible(&transport->owner_lock);
+	if (ret)
+		return ret;
+	if (transport->owner && transport->owner != owner) {
+		mutex_unlock(&transport->owner_lock);
+		return -EBUSY;
+	}
+	if (!transport->owner) {
+		if (layout_valid(transport)) {
+			previous_generation =
+				readl(&control->layout.generation);
+			quiesce = previous_generation != 0U &&
+				readl(&control->rtos_peer.state) ==
+					SG2002_RTOS_SHM_STATE_READY &&
+				readl(&control->rtos_peer.generation) ==
+					previous_generation;
+		}
+		WRITE_ONCE(transport->owner, owner);
+		if (quiesce) {
+			writel(SG2002_RTOS_SHM_STATE_OFFLINE,
+			       &control->linux_peer.state);
+			wmb();
+			writel(0U, &control->layout.magic);
+			wmb();
+			WRITE_ONCE(transport->generation, 0U);
+			notification = atomic_read(&transport->notifications);
+			request_kick(transport);
+			wait_result = wait_event_interruptible_timeout(
+				transport->wait,
+				atomic_read(&transport->notifications) !=
+					notification,
+				msecs_to_jiffies(
+					SG2002_RTOS_SHM_DEFAULT_TIMEOUT_MS));
+			if (wait_result <= 0L) {
+				mutex_unlock(&transport->owner_lock);
+				sg2002_rtos_shm_linux_release(
+					transport, owner);
+				return wait_result == 0L ?
+					-ETIMEDOUT : wait_result;
+			}
+		}
+		initialize_generation(transport, previous_generation);
+		request_kick(transport);
+	}
+	mutex_unlock(&transport->owner_lock);
+
+	wait_result = wait_event_interruptible_timeout(
+		transport->wait, rtos_ready(transport),
+		msecs_to_jiffies(SG2002_RTOS_SHM_DEFAULT_TIMEOUT_MS));
+	if (wait_result <= 0) {
+		sg2002_rtos_shm_linux_release(transport, owner);
+		return wait_result == 0 ? -ETIMEDOUT : wait_result;
+	}
+	fill_info(transport, &info);
+	if (copy_to_user((void __user *)argument, &info, sizeof(info))) {
+		sg2002_rtos_shm_linux_release(transport, owner);
+		return -EFAULT;
+	}
+	return 0;
+}
+
+static long send_message(struct sg2002_rtos_shm_linux *transport,
+	struct file *owner, unsigned long argument)
+{
+	struct sg2002_rtos_shm_control __iomem *control =
+		shm_control(transport);
+	struct sg2002_rtos_shm_transfer transfer;
+	void __iomem *slot;
+	long remaining;
+	u32 producer;
+	u32 occupancy;
+	u32 sequence;
+	int ret;
+
+	if (!is_owner(transport, owner))
+		return -EPERM;
+	if (copy_from_user(&transfer, (void __user *)argument,
+			   sizeof(transfer)))
+		return -EFAULT;
+	if (transfer.message.length > SG2002_RTOS_SHM_PAYLOAD_SIZE)
+		return -EMSGSIZE;
+
+	ret = mutex_lock_interruptible(&transport->tx_lock);
+	if (ret)
+		return ret;
+	remaining = transfer.timeout_ms == 0U ? 0L :
+		wait_jiffies(transfer.timeout_ms);
+	for (;;) {
+		if (!rtos_ready(transport)) {
+			ret = -ENOTCONN;
+			goto out_unlock;
+		}
+		ret = request_occupancy(transport, &producer, NULL,
+					&occupancy);
+		if (ret)
+			goto out_unlock;
+		if (occupancy < SG2002_RTOS_SHM_SLOT_COUNT)
+			break;
+		if (remaining == 0L) {
+			ret = transfer.timeout_ms == 0U ? -EAGAIN : -ETIMEDOUT;
+			goto out_unlock;
+		}
+		remaining = wait_event_interruptible_timeout(
+			transport->wait, request_wait_done(transport),
+			remaining);
+		if (remaining < 0L) {
+			ret = remaining;
+			goto out_unlock;
+		}
+	}
+
+	do {
+		sequence = transport->next_sequence++;
+	} while (sequence == 0U);
+	transfer.message.sequence = sequence;
+	if (copy_to_user((void __user *)argument, &transfer,
+			 sizeof(transfer))) {
+		ret = -EFAULT;
+		goto out_unlock;
+	}
+
+	slot = transport->base + SG2002_RTOS_SHM_REQUEST_OFFSET +
+	       (producer & (SG2002_RTOS_SHM_SLOT_COUNT - 1U)) *
+		       SG2002_RTOS_SHM_SLOT_SIZE;
+	memcpy_toio(slot, &transfer.message, sizeof(transfer.message));
+	wmb();
+	writel(producer + 1U, &control->request_producer.value);
+	wmb();
+	request_kick(transport);
+	ret = 0;
+
+out_unlock:
+	mutex_unlock(&transport->tx_lock);
+	return ret;
+}
+
+static long receive_message(struct sg2002_rtos_shm_linux *transport,
+	struct file *owner, unsigned long argument)
+{
+	struct sg2002_rtos_shm_control __iomem *control =
+		shm_control(transport);
+	struct sg2002_rtos_shm_transfer transfer;
+	void __iomem *slot;
+	long remaining;
+	u32 consumer;
+	u32 occupancy;
+	u32 pending_requests;
+	int ret;
+
+	if (!is_owner(transport, owner))
+		return -EPERM;
+	if (copy_from_user(&transfer, (void __user *)argument,
+			   sizeof(transfer)))
+		return -EFAULT;
+
+	ret = mutex_lock_interruptible(&transport->rx_lock);
+	if (ret)
+		return ret;
+	remaining = transfer.timeout_ms == 0U ? 0L :
+		wait_jiffies(transfer.timeout_ms);
+	for (;;) {
+		if (!rtos_ready(transport)) {
+			ret = -ENOTCONN;
+			goto out_unlock;
+		}
+		ret = response_occupancy(transport, NULL, &consumer,
+					 &occupancy);
+		if (ret)
+			goto out_unlock;
+		if (occupancy > 0U)
+			break;
+		if (remaining == 0L) {
+			ret = transfer.timeout_ms == 0U ? -EAGAIN : -ETIMEDOUT;
+			goto out_unlock;
+		}
+		remaining = wait_event_interruptible_timeout(
+			transport->wait, response_wait_done(transport),
+			remaining);
+		if (remaining < 0L) {
+			ret = remaining;
+			goto out_unlock;
+		}
+	}
+
+	slot = transport->base + SG2002_RTOS_SHM_RESPONSE_OFFSET +
+	       (consumer & (SG2002_RTOS_SHM_SLOT_COUNT - 1U)) *
+		       SG2002_RTOS_SHM_SLOT_SIZE;
+	rmb();
+	memcpy_fromio(&transfer.message, slot, sizeof(transfer.message));
+	if (transfer.message.length > SG2002_RTOS_SHM_PAYLOAD_SIZE) {
+		ret = -EPROTO;
+	} else if (copy_to_user((void __user *)argument, &transfer,
+					 sizeof(transfer))) {
+		ret = -EFAULT;
+		goto out_unlock;
+	} else {
+		ret = 0;
+	}
+	wmb();
+	writel(consumer + 1U, &control->response_consumer.value);
+	wmb();
+	if (!request_occupancy(transport, NULL, NULL,
+			       &pending_requests) && pending_requests > 0U)
+		request_kick(transport);
+
+out_unlock:
+	mutex_unlock(&transport->rx_lock);
+	return ret;
+}
+
+struct sg2002_rtos_shm_linux *sg2002_rtos_shm_linux_create(
+	struct device *device, resource_size_t start, resource_size_t size,
+	sg2002_rtos_shm_kick_fn kick, void *kick_context)
+{
+	struct sg2002_rtos_shm_linux *transport;
+
+	if (!device || !kick)
+		return ERR_PTR(-EINVAL);
+	if (size != SG2002_RTOS_SHM_REGION_SIZE)
+		return ERR_PTR(-EINVAL);
+	transport = devm_kzalloc(device, sizeof(*transport), GFP_KERNEL);
+	if (!transport)
+		return ERR_PTR(-ENOMEM);
+	transport->base = devm_ioremap(device, start, size);
+	if (!transport->base)
+		return ERR_PTR(-ENOMEM);
+	transport->device = device;
+	transport->size = size;
+	transport->kick = kick;
+	transport->kick_context = kick_context;
+	mutex_init(&transport->owner_lock);
+	mutex_init(&transport->tx_lock);
+	mutex_init(&transport->rx_lock);
+	init_waitqueue_head(&transport->wait);
+	INIT_DELAYED_WORK(&transport->kick_work, kick_work);
+	atomic_set(&transport->kick_attempts, 0);
+	atomic_set(&transport->notifications, 0);
+	return transport;
+}
+
+void sg2002_rtos_shm_linux_destroy(
+	struct sg2002_rtos_shm_linux *transport)
+{
+	struct sg2002_rtos_shm_control __iomem *control;
+
+	if (!transport)
+		return;
+	cancel_delayed_work_sync(&transport->kick_work);
+	mutex_lock(&transport->owner_lock);
+	control = shm_control(transport);
+	writel(SG2002_RTOS_SHM_STATE_OFFLINE,
+	       &control->linux_peer.state);
+	wmb();
+	WRITE_ONCE(transport->owner, NULL);
+	wake_up_interruptible(&transport->wait);
+	mutex_unlock(&transport->owner_lock);
+}
+
+void sg2002_rtos_shm_linux_notify(
+	struct sg2002_rtos_shm_linux *transport)
+{
+	if (transport) {
+		atomic_inc(&transport->notifications);
+		wake_up_interruptible(&transport->wait);
+	}
+}
+
+void sg2002_rtos_shm_linux_release(
+	struct sg2002_rtos_shm_linux *transport, struct file *owner)
+{
+	struct sg2002_rtos_shm_control __iomem *control;
+
+	if (!transport || !owner)
+		return;
+	mutex_lock(&transport->owner_lock);
+	if (transport->owner == owner) {
+		control = shm_control(transport);
+		writel(SG2002_RTOS_SHM_STATE_OFFLINE,
+		       &control->linux_peer.state);
+		wmb();
+		WRITE_ONCE(transport->owner, NULL);
+		wake_up_interruptible(&transport->wait);
+	}
+	mutex_unlock(&transport->owner_lock);
+}
+
+long sg2002_rtos_shm_linux_ioctl(
+	struct sg2002_rtos_shm_linux *transport, struct file *owner,
+	unsigned int command, unsigned long argument)
+{
+	if (!transport)
+		return -ENODEV;
+	switch (command) {
+	case SG2002_RTOS_SHM_ACQUIRE:
+		return acquire(transport, owner, argument);
+	case SG2002_RTOS_SHM_SEND:
+		return send_message(transport, owner, argument);
+	case SG2002_RTOS_SHM_RECEIVE:
+		return receive_message(transport, owner, argument);
+	default:
+		return -ENOTTY;
+	}
+}
+
+__poll_t sg2002_rtos_shm_linux_poll(
+	struct sg2002_rtos_shm_linux *transport, struct file *owner,
+	struct poll_table_struct *wait)
+{
+	__poll_t mask = 0;
+	u32 occupancy;
+
+	if (!transport || !is_owner(transport, owner))
+		return EPOLLERR;
+	poll_wait(owner, &transport->wait, wait);
+	if (!rtos_ready(transport))
+		return EPOLLERR | EPOLLHUP;
+	if (response_occupancy(transport, NULL, NULL, &occupancy))
+		return EPOLLERR;
+	if (occupancy > 0U)
+		mask |= EPOLLIN | EPOLLRDNORM;
+	if (request_occupancy(transport, NULL, NULL, &occupancy))
+		return EPOLLERR;
+	if (occupancy < SG2002_RTOS_SHM_SLOT_COUNT)
+		mask |= EPOLLOUT | EPOLLWRNORM;
+	return mask;
+}
