 EXPORT_SYMBOL(rtos_cmdqu_send);
 
+static int cvi_rtos_cmdqu_shm_kick(void *context, u32 generation)
+{
+	cmdqu_t command = {0};
+
+	command.ip_id = IP_SYSTEM;
+	command.cmd_id = SG2002_RTOS_SHM_DOORBELL_COMMAND;
+	command.block = 0;
+	command.param_ptr = generation;
+	return rtos_cmdqu_send(&command);
+}
+
