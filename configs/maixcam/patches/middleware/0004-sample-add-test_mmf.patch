+static CVI_S32 _mmf_vi_init(CVI_U32 width, CVI_U32 height, PIXEL_FORMAT_E format, int fps)
+{
+	VPSS_GRP out_grp;
+	CVI_S32 s32Ret = CVI_SUCCESS;
+	if (priv.vi_is_inited) {
+		return s32Ret;
