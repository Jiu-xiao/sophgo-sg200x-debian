+		.h = h,
+		.fmt = PIXEL_FORMAT_NV21,
+		.jpg_quality = 0,  // unused
+		.gop = 50,
+		.intput_fps = 30,
+		.output_fps = 30,
+		.bitrate = 3000,
+	};
+
+	return _mmf_enc_h264_init(ch, &cfg);
+}
+#endif
