+		memcpy(stCanvasInfo.pu8VirtAddr, data, len);
+	} else {
+		printf("Not support format!\r\n");
+		return CVI_FAILURE;
+	}
+
+	s32Ret = CVI_RGN_UpdateCanvas(ch);
+	if (s32Ret != CVI_SUCCESS) {
+		printf("CVI_RGN_UpdateCanvas failed with %#x!\n", s32Ret);
+		return CVI_FAILURE;
+	}
