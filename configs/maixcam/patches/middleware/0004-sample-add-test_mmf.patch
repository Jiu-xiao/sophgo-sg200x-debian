+					case PIXEL_FORMAT_NV21:
+					for (int h = 0; h < img_h * 3 / 2; h ++) {
+						memcpy(show_img + h * img_w, (uint8_t *)data + h * width, img_w);
+					}
+					break;
+					default:break;
+				}
+			} else {
