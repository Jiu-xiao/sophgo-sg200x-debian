+		}
+		UNUSED(save_buff_to_file);
+		free(show_img);
+	}
+
+	mmf_del_vo_channel(layer, vo_ch);
+	mmf_del_vi_channel(vi_ch);
+	mmf_vi_deinit();
+	mmf_deinit();
+	return 0;
