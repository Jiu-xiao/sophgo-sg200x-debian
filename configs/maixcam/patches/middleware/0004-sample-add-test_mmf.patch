+static CVI_S64 _get_ion_size_info(const char *path)
+{
+	FILE *fd = NULL;
+	char val[256] = {0};
+
+	fd = fopen(path, "r");
+
+	if (fd == NULL) {
+		fprintf(stderr, "Error opening file %s\n", path);
+		return -1;
+	}
+
+	memset(val, 0, 128);
+
+	fgets(val, 128, fd);
+
+	pclose(fd);
+
+	return atol(val);
+}
