+	s32Ret = _mmf_vpss_init_new_with_fps(out_grp, width, height, format, fps);
+	if (s32Ret != CVI_SUCCESS) {
+		printf("_mmf_vpss_init_new failed. s32Ret: 0x%x !\n", s32Ret);
+		return s32Ret;
+	}
+
+	priv.vi_vpss = out_grp;
+	priv.vi_is_inited = true;
+
+	return s32Ret;
+}
