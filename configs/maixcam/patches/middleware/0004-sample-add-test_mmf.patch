+				rtsp_media_t& session = it->second;
+				if (1 == session.status) {
+					session.media->Play();
+				}
+			}
+		}
+
+		rtsp_server_destroy(rtsp);
+		socket_close(tcp);
+	}
+
+	socket_close(socket);
+}
