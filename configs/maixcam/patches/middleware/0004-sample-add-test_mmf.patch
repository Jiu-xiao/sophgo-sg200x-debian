+				size_t n = r;
+				r = rtsp_server_input(rtsp, buffer, &n);
+				assert(n == 0 && r == 0);
+			}
+			else if (r <= 0 && r != SOCKET_TIMEDOUT)
+			{
+				break;
+			}
+
+			TSessions::iterator it;
+			AutoThreadLocker locker(s_locker);
+
+			for (it = s_sessions.begin(); it != s_sessions.end(); ++it)
