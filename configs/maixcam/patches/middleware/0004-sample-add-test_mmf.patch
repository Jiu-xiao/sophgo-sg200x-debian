+int mmf_region_frame_push(int ch, void *data, int len)
+{
+	CVI_S32 s32Ret;
+	RGN_CANVAS_INFO_S stCanvasInfo;
+
+	if (ch < 0 || ch >= MMF_RGN_MAX_NUM) {
+		printf("Handle ch is illegal %d!\n", ch);
+		return CVI_FAILURE;
+	}
+
+	if (!priv.rgn_is_init[ch]) {
