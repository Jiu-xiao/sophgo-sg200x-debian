+// manage vo channels
+int mmf_get_vo_unused_channel(int layer) {
+	switch (layer) {
+	case MMF_VO_VIDEO_LAYER:
+		for (int i = 0; i < MMF_VO_VIDEO_MAX_CHN; i++) {
+			if (priv.vo_video_chn_is_inited[i] == false) {
+				return i;
+			}
