+	OLED_ColorTurn(olde_fb, 0);	//0正常显示 1 反色显示
+  	OLED_DisplayTurn(olde_fb, 0);	//0正常显示 1 屏幕翻转显示
+	OLED_Clear(olde_fb);
+oled_disable:
+	oled_i2c_init(OLED_DISABLE, &olde_fb);
+}
