+	if (!cfg) {
+		printf("%s: cfg is not set.\n", __func__);
+		return -1;
+	}
+
+	memcpy(cfg, &priv.dec_chn_cfg[ch], sizeof(priv.dec_chn_cfg[ch]));
+
+	return 0;
